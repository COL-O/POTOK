# Патч 0002 — честная отписка и без утечки горутин (core/eventbus.go)
#
# Адрес: core/eventbus.go — Subscribe (отписка) и Publish.
# Причина 1 (отписка): сравнение `&s.handler == &handler` в срезе подписок не может быть
#   истинным — в срезе лежит копия, а сравнивается адрес параметра. Подписки НЕ снимались
#   никогда, Stop модуля ничего не снимал, обработчики продолжали работать.
# Причина 2 (Publish): обработчик вызывался как `go func(...)`. Горутина переживала
#   возврат из Publish и работала после Stop — гонки под -race и «висящие» обработчики
#   в тестах роутеров.
# Правка: у подписки есть идентификатор, отписка — по нему (и через sync.Once);
#   Publish копирует срез подписчиков под RLock и вызывает обработчики синхронно.
# Проверено: чтение кода + gocheck на клоне дома — чисто.
# НЕ проверено: поведение под `-race` — нужен прогон у основателя/CI.
# Применение из корня дома:
#   git apply --check pritok/patches/0002-core-eventbus-unsubscribe.patch && git apply pritok/patches/0002-core-eventbus-unsubscribe.patch
--- a/core/eventbus.go
+++ b/core/eventbus.go
@@ -3,6 +3,7 @@ package core
 import (
 	"context"
 	"sync"
+	"sync/atomic"
 )
 
 type Event struct {
@@ -20,9 +21,11 @@ type EventBus interface {
 type bus struct {
 	mu       sync.RWMutex
 	handlers map[string][]subscriber
+	nextID   atomic.Uint64
 }
 
 type subscriber struct {
+	id      uint64
 	module  string
 	handler func(ctx context.Context, ev Event) error
 }
@@ -34,33 +37,40 @@ func NewEventBus() EventBus {
 func (b *bus) Publish(ctx context.Context, source string, targets []string, topic string, payload any) error {
 	ev := Event{Source: source, Targets: targets, Topic: topic, Payload: payload}
 	b.mu.RLock()
-	subs := b.handlers[topic]
+	subs := append([]subscriber(nil), b.handlers[topic]...)
 	b.mu.RUnlock()
 	for _, s := range subs {
 		if len(targets) > 0 && !contains(targets, s.module) {
 			continue
 		}
-		go func(s subscriber) {
-			_ = s.handler(ctx, ev)
-		}(s)
+		// Синхронный вызов: при `go func` горутина переживала тест и работала
+		// после Stop, что давало гонки под -race и «висящие» обработчики.
+		_ = s.handler(ctx, ev)
 	}
 	return nil
 }
 
 func (b *bus) Subscribe(ctx context.Context, moduleName, topic string, handler func(ctx context.Context, ev Event) error) (func(), error) {
+	id := b.nextID.Add(1)
 	b.mu.Lock()
 	defer b.mu.Unlock()
-	b.handlers[topic] = append(b.handlers[topic], subscriber{module: moduleName, handler: handler})
+	b.handlers[topic] = append(b.handlers[topic], subscriber{id: id, module: moduleName, handler: handler})
+	var once sync.Once
 	return func() {
-		b.mu.Lock()
-		defer b.mu.Unlock()
-		subs := b.handlers[topic]
-		for i, s := range subs {
-			if s.module == moduleName && &s.handler == &handler {
-				b.handlers[topic] = append(subs[:i], subs[i+1:]...)
-				break
+		once.Do(func() {
+			b.mu.Lock()
+			defer b.mu.Unlock()
+			subs := b.handlers[topic]
+			for i, s := range subs {
+				// Отписка по идентификатору подписки: сравнение адресов
+				// (&s.handler == &handler) не могло быть истинным никогда —
+				// в срезе лежит копия, и подписки не снимались.
+				if s.id == id {
+					b.handlers[topic] = append(subs[:i], subs[i+1:]...)
+					break
+				}
 			}
-		}
+		})
 	}, nil
 }
 
