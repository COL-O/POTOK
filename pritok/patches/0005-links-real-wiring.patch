# Патч 0005 — сквозная цепочка на одной шине (core, links, main, modules/*)
#
# Адреса в доме на 5374239:
#   core/registry.go:63 — `env := &Env{Registry: r, Bus: NewEventBus()}` внутри StartAll.
#   links/polygon_front.go, links/polygon_growth.go, links/growth_stratos.go,
#   links/stratos_all.go — заглушки `_ = p; _ = f; _ = bus`: связь обещана, но не создана.
#   main.go:81-82 — `eventBus := core.NewEventBus()` создаётся ПОСЛЕ reg.Register
#                   и никуда не передаётся; StartAll всё равно раздаст модулям свои шины.
#
# Причина (проверено чтением, не догадка):
#   TestOrganismChainOnStuckFlight (organism_test.go:22) требует, чтобы FlightEvent,
#   опубликованный front.Publish, дошёл до polygon/growth/stratos. Сейчас каждый
#   модуль получает СВОЮ шину, поэтому подписка и публикация живут в разных мирах:
#   цепочка рвётся на первом шаге.
#   Отдельно проверено и НЕ подтвердилось: будто front не публикует FlightStuck.
#   Публикует — modules/front/module.go:84 (`if flight.Status == contracts.StatusStuck`).
#   То есть ломается не машина состояний, а доставка событий.
#
# Правка (сверху вниз, без переписывания слоёв):
#   1. core: у реестра появляется SetBus; StartAll отдаёт модулям общую шину.
#   2. modules/{front,polygon,growth,stratos}: SetBus — мостик links.
#   3. links/*: мостики перестают быть заглушками и передают шину модулям.
#   4. main.go: шина создаётся ДО реестра и отдаётся ему.
#
# Проверено: gocheck на чистом клоне дома (114 файлов, 29 пакетов) — 0 проблем;
#            git apply --check на 5374239 — OK.
# НЕ проверено: go test -race ./... — Go в песочнице нет. Скажет прогон у основателя или CI.
# Применение из корня дома:
#   git apply --check pritok/patches/0005-links-real-wiring.patch && \
#     git apply pritok/patches/0005-links-real-wiring.patch && go test -race ./...

diff --git a/core/registry.go b/core/registry.go
index 4a1d3e7..f887356 100644
--- a/core/registry.go
+++ b/core/registry.go
@@ -30,6 +30,14 @@ func NewRegistry() Registry {
 	}
 }
 
+// SetBus задаёт общую шину организма. Без него StartAll создаёт каждому
+// модулю свою шину, и модули не слышат друг друга.
+func (r *registry) SetBus(b EventBus) {
+	if b != nil {
+		r.bus = b
+	}
+}
+
 func (r *registry) Register(m Module, manifest Manifest) error {
